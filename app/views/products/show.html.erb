<% content_for :title, @product.name %>

<div class="mb-6">
  <%= link_to "← Back to products", products_path, class: "text-indigo-600 hover:underline" %>
</div>

<div class="bg-white shadow-md rounded-xl overflow-hidden max-w-4xl mx-auto">
  <% if @product.image.attached? %>
    <%= image_tag @product.image, class: "w-full h-96 object-cover" %>
  <% else %>
    <div class="w-full h-96 bg-gray-200 flex items-center justify-center text-gray-500">
      No image
    </div>
  <% end %>

  <div class="p-6">
    <h1 class="text-3xl font-bold mb-2"><%= @product.name %></h1>

    <p class="text-gray-600 mb-1">
      <strong>Brand:</strong> <%= @product.brand.name %><br>
      <strong>Category:</strong> <%= @product.category.name %>
    </p>

    <p class="text-lg text-indigo-600 font-semibold mb-4">
      <%= number_to_currency(@product.price) %>
    </p>

    <p class="text-gray-800 leading-relaxed mb-6"><%= simple_format(@product.description) %></p>

    <div class="flex flex-col sm:flex-row gap-4">
      <%= button_to 'Add to Cart',
                    add_cart_path(product_id: @product.id),
                    method: :post,
                    class:"bg-[#8ab6d6] hover:bg-[#7aa4c5] text-white text-sm font-semibold px-5 py-2 rounded-md shadow-inner transition "%>

    </div>
  </div>
</div>