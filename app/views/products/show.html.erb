<% content_for :title, @product.name %>

<div class="flex flex-col md:flex-row gap-8 items-start">
  <% if @product.image.attached? %>
    <%= image_tag @product.image, class: "w-full md:w-1/2 rounded-lg shadow-md object-cover" %>
  <% else %>
    <div class="w-full md:w-1/2 h-64 bg-gray-200 flex items-center justify-center text-gray-400 rounded">No Image</div>
  <% end %>

  <div class="flex-1">
    <h1 class="text-3xl font-bold text-gray-800 mb-4"><%= @product.name %></h1>

    <p class="text-gray-500 mb-1"><strong>Brand:</strong> <%= @product.brand&.name || "No brand" %></p>
    <p class="text-gray-500 mb-4"><strong>Category:</strong> <%= @product.category&.name || "No category" %></p>

    <p class="text-gray-700 mb-4"><%= @product.description %></p>

    <p class="text-indigo-600 font-bold text-2xl mb-6">$<%= @product.price %></p>

    <div class="flex gap-4">
      <%= link_to "✏️ Edit", edit_product_path(@product), class: "bg-yellow-500 text-white px-4 py-2 rounded hover:bg-yellow-600 transition" %>
      <%= button_to "🗑️ Delete", @product, method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 transition" %>
      <%= link_to "⬅️ Back", products_path, class: "bg-gray-300 text-gray-800 px-4 py-2 rounded hover:bg-gray-400 transition" %>
    </div>
  </div>
</div>