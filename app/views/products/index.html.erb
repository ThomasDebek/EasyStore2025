<% content_for :title, "Products" %>

<h1 class="text-3xl font-bold text-gray-800 mb-6">Our Products</h1>

<div id="products" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @products.each do |product| %>
    <div class="bg-white rounded-xl shadow-md p-4 flex flex-col h-full">
      <% if product.image.attached? %>
        <%= image_tag product.image, class: "rounded-md mb-4 w-full h-48 object-cover" %>
      <% end %>

      <div class="flex-1">
        <h2 class="text-lg font-semibold mb-1"><%= product.name %></h2>

        <p class="text-gray-500 text-sm mb-1">
          <strong>Brand:</strong> <%= product.brand&.name || "No brand" %>
        </p>
        <p class="text-gray-500 text-sm mb-3">
          <strong>Category:</strong> <%= product.category&.name || "No category" %>
        </p>

        <p class="text-gray-600 text-sm line-clamp-3 mb-4"><%= product.description %></p>
        <p class="text-indigo-600 font-bold mb-4"><%= number_to_currency(product.price) %></p>
      </div>

      <%= link_to "Show this product", product, class: "mt-auto inline-block bg-indigo-600 text-white text-sm font-medium py-2 px-4 rounded hover:bg-indigo-700 transition" %>
    </div>
  <% end %>
</div>

<div class="mt-8">
  <%= link_to "➕ New Product", new_product_path, class: "inline-block bg-green-600 text-white px-5 py-2 rounded hover:bg-green-700 transition" %>
</div>