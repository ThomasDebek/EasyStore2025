<% content_for :title, "Products" %>

<h1 class="text-3xl font-bold text-gray-800 mb-6">Our Products</h1>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @products.each do |product| %>
    <div class="bg-white shadow-md rounded-xl overflow-hidden hover:shadow-lg transition">
      <% if product.image.attached? %>
        <%= image_tag product.image, class: "w-full h-48 object-cover" %>
      <% else %>
        <div class="w-full h-48 bg-gray-200 flex items-center justify-center text-gray-400">No Image</div>
      <% end %>

      <div class="p-4">
        <h2 class="text-xl font-semibold text-gray-800 mb-2"><%= product.name %></h2>
        <p class="text-gray-600 text-sm mb-2"><%= truncate(product.description, length: 100) %></p>
        <p class="text-indigo-600 font-bold text-lg mb-4">$<%= product.price %></p>

        <%= link_to "View Product", product, class: "inline-block bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition" %>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-8">
  <%= link_to "➕ New Product", new_product_path, class: "inline-block bg-green-600 text-white px-5 py-2 rounded hover:bg-green-700 transition" %>
</div>