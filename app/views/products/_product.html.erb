<div id="<%= dom_id product %>" class="max-w-xl mx-auto mt-10 bg-white shadow-lg rounded-xl p-6 space-y-4 border border-gray-200">
  <div>
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Product Details</h2>
  </div>

  <div>
    <p class="text-sm text-gray-500 font-semibold uppercase">Name</p>
    <p class="text-lg text-gray-800"><%= product.name %></p>
  </div>

  <div>
    <p class="text-sm text-gray-500 font-semibold uppercase">Description</p>
    <p class="text-gray-700"><%= product.description %></p>
  </div>

  <div>
    <p class="text-sm text-gray-500 font-semibold uppercase">Price</p>
    <p class="text-gray-800 font-medium">$<%= product.price %></p>
  </div>

  <% if product.image.attached? %>
    <div>
      <p class="text-sm text-gray-500 font-semibold uppercase mb-2">Image</p>
      <%= image_tag product.image, class: "rounded-lg shadow-md w-full max-w-md object-cover" %>
    </div>
  <% end %>
</div>