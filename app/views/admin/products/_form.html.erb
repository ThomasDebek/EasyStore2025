<!-- app/views/admin/products/_form.html.erb -->
<%= form_with(model: admin_product, local: true, html: { class: "contents" }) do |form| %>
  <% if admin_product.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(admin_product.errors.count, "error") %> prohibited this product from being saved:</h2>
      <ul class="list-disc ml-6">
        <% admin_product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: "block shadow rounded-md border outline-none px-3 py-2 mt-2 w-full #{admin_product.errors[:name].any? ? 'border-red-400 focus:outline-red-600' : 'border-gray-400 focus:outline-blue-600'}" %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.text_field :description, class: "block shadow rounded-md border outline-none px-3 py-2 mt-2 w-full #{admin_product.errors[:description].any? ? 'border-red-400 focus:outline-red-600' : 'border-gray-400 focus:outline-blue-600'}" %>
  </div>

  <div class="my-5">
    <%= form.label :price %>
    <%= form.text_field :price, class: "block shadow rounded-md border outline-none px-3 py-2 mt-2 w-full #{admin_product.errors[:price].any? ? 'border-red-400 focus:outline-red-600' : 'border-gray-400 focus:outline-blue-600'}" %>
  </div>

  <div class="my-5">
    <%= form.label :brand_id, "Brand", class: "block font-medium mb-1" %>
    <%= form.collection_select :brand_id, @brands, :id, :name,
                               { prompt: "Select brand" },
                               class: "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 pr-8 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 appearance-none cursor-pointer" %>
  </div>

  <div class="my-5">
    <%= form.label :category_id, "Category", class: "block font-medium mb-1" %>
    <%= form.collection_select :category_id, @categories, :id, :name,
                               { prompt: "Select category" },
                               class: "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 pr-8 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 appearance-none cursor-pointer" %>
  </div>

  <div class="my-5">
    <%= form.label :image, "Product Image", class: "block font-medium mb-1" %>
    <%= form.file_field :image, class: "block w-full text-gray-700 cursor-pointer" %>

    <% if admin_product.image.attached? %>
      <div class="mt-3">
        <p>Current image:</p>
        <%= image_tag admin_product.image.variant(resize_to_limit: [150, 150]), class: "rounded-md shadow" %>
      </div>
    <% end %>
  </div>

  <div class="inline">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>