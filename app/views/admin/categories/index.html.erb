<% content_for :title, "Categories" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-4 bg-white border border-green-300 text-green-600 mb-5 text-sm font-medium rounded-md shadow-sm" id="notice">
      <%= notice %>
    </p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl text-gray-800">Categories</h1>
    <%= link_to "New category", new_admin_category_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 transition text-sm font-medium shadow-sm" %>
  </div>

  <% if @categories.any? %>
    <table class="min-w-full bg-white border border-gray-200 shadow rounded-lg overflow-hidden">
      <thead class="bg-gray-50">
      <tr>
        <th class="text-left px-4 py-3 text-sm font-medium text-gray-600 border-b">Name</th>
        <th class="px-4 py-3 text-sm font-medium text-gray-600 text-center border-b">Actions</th>
      </tr>
      </thead>

      <tbody>
      <% @categories.each do |category| %>
        <tr class="hover:bg-gray-50 transition">
          <td class="px-4 py-3 text-gray-900 border-b"><%= category.name %></td>
          <td class="px-4 py-3 border-b">
            <div class="flex justify-center gap-2">
              <%= link_to "Show", admin_category_path(category), class: "px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 text-sm hover:bg-blue-100 transition font-medium" %>
              <%= link_to "Edit", edit_admin_category_path(category), class: "px-3 py-1.5 rounded-full bg-yellow-50 text-yellow-700 text-sm hover:bg-yellow-100 transition font-medium" %>
              <%= button_to "Delete", admin_category_path(category), method: :delete, data: { confirm: "Are you sure?" }, class: "px-3 py-1.5 rounded-full bg-red-50 text-red-700 text-sm hover:bg-red-100 transition font-medium" %>
            </div>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center my-10 text-gray-500">No categories found.</p>
  <% end %>
</div>