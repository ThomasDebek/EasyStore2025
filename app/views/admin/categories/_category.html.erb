<div id="<%= dom_id(category) %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= category.name %>
  </p>
  <%= link_to "Edit", edit_admin_category_path(category), class: "btn" %>
  <%= link_to "Delete", admin_category_path(category), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger" %>
</div>