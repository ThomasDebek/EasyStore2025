<%= form_with(model: admin_category, url: admin_category.new_record? ? admin_categories_path : admin_category_path(admin_category), local: true, class: "contents") do |form| %>
  <% if admin_category.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(admin_category.errors.count, "error") %> prohibited this category from being saved:</h2>

      <ul class="list-disc ml-6">
        <% admin_category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: "block shadow rounded-md border outline-none px-3 py-2 mt-2 w-full #{admin_category.errors[:name].any? ? 'border-red-400' : 'border-gray-400'}" %>
  </div>

  <div class="inline">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-indigo-600 text-white font-medium hover:bg-indigo-500" %>
  </div>
<% end %>