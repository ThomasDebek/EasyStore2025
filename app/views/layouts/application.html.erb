<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Easy Store" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
  <%= combobox_style_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="bg-gray-100 text-gray-800 font-sans min-h-screen flex flex-col">

<!-- Header / Navbar -->
<%= render current_user&.admin? ? 'layouts/navbar_admin' : 'layouts/navbar_public' %>

<!-- Main content -->
<main class="flex-1 w-full px-4 sm:px-6 lg:px-16 mt-32 flex gap-8 relative">

  <% if current_user&.admin? %>
    <aside class="w-64 shrink-0 bg-white shadow-md rounded-xl p-6 sticky top-32 h-max">
      <%= render 'layouts/sidebar_admin' %>
    </aside>
  <% end %>

  <section class="flex-1 min-w-0 bg-white shadow-md rounded-xl p-6">
    <%= render 'layouts/alert' %>
    <%= yield %>
  </section>

  <% if (controller.controller_path == "products" || controller.controller_path == "admin/products") &&
        controller.action_name == "index" &&
        @brands.present? && @categories.present? %>
    <aside class="w-64 shrink-0 bg-white shadow-md rounded-xl p-6 sticky top-32 h-max">
      <%= render 'layouts/filters' %>
    </aside>
  <% end %>

</main>

<!-- Footer -->
<footer class="text-center text-sm text-gray-400 mt-10 py-6">
  &copy; <%= Time.current.year %> Easy Store. All rights reserved.
</footer>

</body>
</html>