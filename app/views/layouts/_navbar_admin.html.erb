<header class="bg-blue-800 shadow-md fixed top-0 left-0 w-full z-50">
  <div class="container mx-auto px-5 py-4 flex justify-between items-center">
    <!-- Logo -->
    <div class="text-lg font-semibold text-white">
      <%= link_to "🛍️ Easy Store Admin", admin_products_path, class: "hover:text-lime-400" %>
    </div>

    <!-- Pasek wyszukiwania + informacje o użytkowniku -->
    <div class="space-x-6 flex items-center">
      <!-- Form wyszukiwania -->
      <%= form_with url: admin_products_path, method: :get, local: true, class: "flex items-center space-x-2" do |form| %>
        <%= form.text_field :query, value: params[:query], placeholder: "Search products...", class: "px-3 py-1 rounded-md text-sm text-black" %>
        <%= form.submit "Search", class: "bg-lime-400 text-blue-900 px-3 py-1 rounded-md text-sm font-semibold hover:bg-lime-500" %>
      <% end %>

      <!-- Dane użytkownika i logout -->
      <span class="text-sm text-lime-200 whitespace-nowrap">Admin: <%= current_user.email %></span>
      <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "text-sm font-semibold text-white hover:text-red-400" %>
    </div>
  </div>
</header>