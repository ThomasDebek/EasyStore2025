<% devise_mapping = Devise.mappings[:user] %>
<% resource_class = devise_mapping.to %>
<% resource_name = devise_mapping.name %>

<header class="bg-white shadow-md fixed top-0 left-0 w-full z-50">
  <div class="container mx-auto px-5 py-4 flex items-center justify-between">

    <!-- Logo -->
    <div class="flex-shrink-0 text-lg font-semibold">
      <%= link_to "🛍️ Easy Store", root_path, class: "hover:text-lime-100" %>
    </div>

    <!-- Pogoda -->
    <div class="hidden sm:flex flex-shrink-0 ml-4 px-3 py-1 bg-blue-50 rounded-md shadow-sm text-sm text-blue-900">
      <%= render partial: 'weather/show' %>
    </div>

    <!-- Wyszukiwarka -->
   <%= render 'products/combobox' %>

    <!-- Prawa strona nagłówka -->
    <div class="flex items-center space-x-6 flex-shrink-0">

      <!-- Koszyk -->
      <% if user_signed_in? && current_user.cart.present? %>
        <%= link_to cart_path, class: "relative inline-block text-gray-700 hover:text-blue-600" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 7h14l-2-7M9 21a1 1 0 11-2 0 1 1 0 012 0zm8 0a1 1 0 11-2 0 1 1 0 012 0z" />
          </svg>
          <% item_count = current_user.cart.cart_items.count %>
          <% if item_count > 0 %>
            <span class="absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white bg-red-600 rounded-full">
              <%= item_count %>
            </span>
          <% end %>
        <% end %>
      <% end %>

      <!-- Logika użytkownika -->
      <% if user_signed_in? %>
        <% if current_user.admin? %>
          <%= link_to "Admin Panel", admin_products_path, class: "hover:text-lime-200 font-semibold" %>
        <% end %>

        <span class="text-sm text-green-700 font-semibold">👤 <%= current_user.email %></span>
        <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "hover:text-red-200" %>

      <% else %>
        <%= link_to "Sign Up", new_user_registration_path,
                    class: "text-gray-700 font-medium transition-transform duration-200 ease-in-out hover:scale-110 hover:text-blue-600" %>

        <%= link_to "Login", new_user_session_path,
                    class: "text-gray-700 font-medium transition-transform duration-200 ease-in-out hover:scale-110 hover:text-blue-600" %>


        <!-- Omniauth Google Login with smaller image buttons -->
        <% if devise_mapping.omniauthable? %>
          <% resource_class.omniauth_providers.each do |provider| %>
            <%= form_for 'Login',
                         url: omniauth_authorize_path(resource_name, provider),
                         method: :post,
                         data: { turbo: false },
                         class: "inline-block" do |f| %>
              <%= f.submit "Log in with #{provider.to_s.titleize}",
                           type: "image",
                           src: image_path("ios_dark_rd_na@3x.png"),
                           alt: "Log in with #{provider.to_s.titleize}",
                           class: "w-8 h-8" %>
            <% end %>
          <% end %>
        <% end %>



      <% end %>
    </div>

  </div>
</header>