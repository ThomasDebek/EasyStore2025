<h4 class="font-semibold mb-2">Brand</h4>
<ul>
  <li>
    <%= link_to "All Brands", products_path(params.permit!.to_h.except(:brand_id, :category_id)), class: (!params[:brand_id] ? "font-bold" : "") %>
  </li>
  <% @brands.each do |brand| %>
    <li>
      <%= link_to brand.name, products_path(params.permit!.to_h.merge(brand_id: brand.id)), class: (params[:brand_id].to_i == brand.id ? "font-bold text-indigo-600" : "") %>
    </li>
  <% end %>
</ul>

<h4 class="font-semibold mt-4 mb-2">Category</h4>
<ul>
  <li>
    <%= link_to "All Categories", products_path(params.permit!.to_h.except(:category_id, :brand_id)), class: (!params[:category_id] ? "font-bold" : "") %>
  </li>
  <% @categories.each do |category| %>
    <li>
      <%= link_to category.name, products_path(params.permit!.to_h.merge(category_id: category.id)), class: (params[:category_id].to_i == category.id ? "font-bold text-indigo-600" : "") %>
    </li>
  <% end %>
</ul>