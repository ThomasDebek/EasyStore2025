<% path_for_filters = controller_path.start_with?('admin/') ? admin_products_path : products_path %>

<h4 class="font-semibold mb-2">Brand</h4>
<ul class="space-y-1">
  <li>
    <%= link_to "All Brands", path_for_filters + "?" + params.permit!.to_h.except(:brand_id).to_query, class: (!params[:brand_id] ? "font-bold" : "") %>
  </li>
  <% @brands.each do |brand| %>
    <li>
      <%= link_to brand.name, path_for_filters + "?" + params.permit!.to_h.merge(brand_id: brand.id).to_query, class: (params[:brand_id].to_i == brand.id ? "font-bold text-indigo-600" : "") %>
    </li>
  <% end %>
</ul>

<h4 class="font-semibold mt-4 mb-2">Category</h4>
<ul class="space-y-1">
  <li>
    <%= link_to "All Categories", path_for_filters + "?" + params.permit!.to_h.except(:category_id).to_query, class: (!params[:category_id] ? "font-bold" : "") %>
  </li>
  <% @categories.each do |category| %>
    <li>
      <%= link_to category.name, path_for_filters + "?" + params.permit!.to_h.merge(category_id: category.id).to_query, class: (params[:category_id].to_i == category.id ? "font-bold text-indigo-600" : "") %>
    </li>
  <% end %>
</ul>